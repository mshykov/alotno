# ---- OS ----
.DS_Store
Thumbs.db

# ---- Rust ----
/target
**/target
**/*.rs.bk
# Cargo.lock is intentionally committed for reproducible builds.

# ---- Build output (Flutter/SwiftPM can drop a build/ anywhere it's invoked) ----
build/

# ---- WASM build output ----
bindings/wasm/pkg/

# ---- Cloudflare Wrangler (local state) ----
.wrangler/

# ---- Node / JS ----
node_modules/
.pnpm-store/
dist/
.astro/
.output/
*.log

# ---- Flutter / Dart ----
apps/app/.dart_tool/
apps/app/.flutter-plugins
apps/app/.flutter-plugins-dependencies
apps/app/build/
apps/app/.idea/
apps/app/ios/Pods/
apps/app/macos/Pods/
apps/app/**/Flutter/ephemeral/

# ---- Generated design tokens (regenerated from design/tokens.json) ----
design/dist/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/

# Release artifacts
*.dmg

# Local secrets — never commit (org convention + underscore variant)
_do-not-commit/
_do_not_commit/

# Xcode SwiftPM workspace state (generated)
**/xcshareddata/swiftpm/
