---
import "@alotno/design/css";

// Cloudflare Pages serves this file, with a real 404 status, for any path that
// has no file. Without a top-level 404.html Pages falls back to SPA mode and
// answers 200 with the home page for every URL (a soft 404). No scripts on
// purpose: the CSP pins the two inline scripts of index.astro by hash.
const site = "https://alotno.app";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Alotno</title>
    <meta name="description" content="This page doesn't exist. Alotno converts PNG to SVG, PDF, EPS, DXF and WebP in your browser." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: var(--font-family-sans);
        background: var(--color-surface-base);
        color: var(--color-ink-base);
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 32rem; padding: var(--space-6); text-align: center; }
      .code { color: var(--color-ink-muted); font-size: var(--font-size-sm); margin: 0 0 var(--space-2); }
      h1 { font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); line-height: 1.15; margin: 0 0 var(--space-3); letter-spacing: -0.01em; }
      p { color: var(--color-ink-muted); line-height: 1.5; margin: 0 0 var(--space-5); }
      a { color: var(--color-brand-500); text-decoration: underline; }
    </style>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>This page doesn't exist or may have moved.</p>
      <a href={`${site}/`}>Back to Alotno</a>
    </main>
  </body>
</html>
