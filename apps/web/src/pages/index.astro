---
import "@alotno/design/css";
import Converter from "../components/Converter.astro";

const site = "https://alotno.app";
const title = "Alotno — Convert PNG to SVG, PDF, EPS, DXF & WebP";
const description =
  "Convert PNG to clean vectors (SVG, PDF, EPS, DXF) and optimized WebP — right in your browser. Fast, batch, and 100% private: nothing is uploaded.";
const ogImage = `${site}/og-image.png`;

// Structured data — makes the page eligible for rich results (per Google's guide).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Alotno",
  url: `${site}/`,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Web, macOS",
  image: ogImage,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Maksym Shykov" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />

    <!-- icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-title" content="Alotno" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alotno — convert PNG to SVG, PDF, EPS, DXF, and WebP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Alotno — convert PNG to SVG, PDF, EPS, DXF, and WebP" />

    <!-- structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- set theme before paint (no flash) -->
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">
        <img src="/icon.png" width="28" height="28" alt="" />
        <span>Alotno</span>
      </a>
      <nav class="navlinks">
        <a href="https://github.com/mshykov/alotno">GitHub</a>
        <button id="theme" class="theme" aria-label="Toggle theme" title="Toggle theme">
          <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" /></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
        </button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <img class="logo" src="/icon.png" width="104" height="104" alt="Alotno — PNG to vector converter" />
        <h1>Convert PNG to vectors — in your browser.</h1>
        <p class="sub">
          SVG, PDF, EPS, DXF, and WebP. Fast, batch, and 100% private —
          your images never leave your device.
        </p>
        <div class="hero-cta">
          <a class="dl" href="https://github.com/mshykov/alotno/releases/latest/download/Alotno-macOS.dmg">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-1.9 1.5-2.8 1.6-2.9-.9-1.3-2.2-1.4-2.7-1.5-1.2-.1-2.3.7-2.8.7-.6 0-1.5-.7-2.5-.7-1.3 0-2.4.7-3.1 1.9-1.3 2.3-.3 5.6.9 7.5.6.9 1.4 1.9 2.3 1.9.9 0 1.2-.6 2.3-.6 1.1 0 1.4.6 2.3.6s1.5-.9 2.1-1.7c.7-1 .9-2 .9-2-.1 0-1.8-.7-1.8-2.6zM14.7 6.3c.5-.6.8-1.5.7-2.3-.7 0-1.6.5-2.1 1.1-.5.5-.9 1.4-.8 2.2.8.1 1.6-.4 2.2-1z"/></svg>
            Download for macOS
          </a>
          <span class="cta-note">free · signed &amp; notarized</span>
        </div>
      </section>

      <Converter />

      <section class="why">
        <h2>Why Alotno</h2>
        <div class="features">
          <div class="feat"><h3>100% private</h3><p>Everything runs locally via WebAssembly. No uploads, no servers, no tracking.</p></div>
          <div class="feat"><h3>Five formats</h3><p>Vector SVG, PDF, EPS, DXF — plus optimized WebP, lossy or lossless.</p></div>
          <div class="feat"><h3>Batch ready</h3><p>Drop a whole folder of PNGs and convert them all at once.</p></div>
          <div class="feat"><h3>One engine, everywhere</h3><p>The same Rust core powers the web, macOS, and (soon) Windows &amp; mobile.</p></div>
        </div>
      </section>

      <section class="how">
        <h2>How to convert a PNG to SVG</h2>
        <ol class="steps">
          <li><strong>Drop your PNGs</strong> into the box above, or click to choose. Multiple files at once is fine.</li>
          <li><strong>Pick the output</strong> — SVG, PDF, EPS, DXF, or WebP — and set the detail level and color mode.</li>
          <li><strong>Convert.</strong> Files are traced to vectors on your own device and download instantly. Nothing is uploaded.</li>
        </ol>
      </section>

      <section class="faq">
        <h2>Frequently asked questions</h2>
        <div class="qa"><h3>Is Alotno free?</h3><p>Yes — it's completely free and open source (AGPL-3.0), with no limits, watermarks, or sign-up.</p></div>
        <div class="qa"><h3>Are my images uploaded anywhere?</h3><p>No. Conversion runs entirely in your browser via WebAssembly, so your images never leave your device.</p></div>
        <div class="qa"><h3>Which formats can I convert PNG to?</h3><p>Vector formats SVG, PDF, EPS, and DXF, plus the WebP raster format (lossy or lossless, color or monochrome).</p></div>
        <div class="qa"><h3>Is there a desktop app?</h3><p>Yes — a free, signed and notarized <a href="https://github.com/mshykov/alotno/releases/latest/download/Alotno-macOS.dmg">macOS app</a> for offline batch conversion. Windows and mobile are coming.</p></div>
      </section>
    </main>

    <footer class="foot">
      <p>Prefer a native app? <a href="https://github.com/mshykov/alotno/releases/latest/download/Alotno-macOS.dmg">Download for macOS</a> — Windows &amp; mobile coming soon.</p>
      <p class="muted">© 2026 Maksym Shykov · <a href="https://github.com/mshykov/alotno">Open source (AGPL-3.0)</a></p>
    </footer>

    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-family-sans);
        background: var(--color-surface-base);
        color: var(--color-ink-base);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-brand-500); text-decoration: none; }
      a:hover { text-decoration: underline; }
      /* Links inside prose must not rely on color alone (WCAG 1.4.1) — underline
         them. Nav links and the .dl button chip are distinguished by layout. */
      .foot a, .sub a { text-decoration: underline; }

      .top { display: flex; align-items: center; justify-content: space-between; max-width: 720px; margin: 0 auto; padding: var(--space-5) var(--space-6); }
      .brand { display: flex; align-items: center; gap: var(--space-2); color: var(--color-ink-base); font-weight: var(--font-weight-bold); }
      .brand:hover { text-decoration: none; }
      .navlinks { display: flex; align-items: center; gap: var(--space-4); }
      .navlinks a { color: var(--color-ink-muted); font-size: var(--font-size-sm); }
      .theme { border: 1px solid var(--color-outline-base); background: var(--color-surface-elevated); color: var(--color-ink-muted); border-radius: var(--radius-sm); width: 34px; height: 34px; display: grid; place-items: center; cursor: pointer; }
      .ico-moon { display: none; }
      :root[data-theme="dark"] .ico-sun { display: none; }
      :root[data-theme="dark"] .ico-moon { display: block; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .ico-sun { display: none; } :root:not([data-theme="light"]) .ico-moon { display: block; } }

      main { max-width: 720px; margin: 0 auto; padding: 0 var(--space-6) var(--space-8); }
      .hero { text-align: center; padding: var(--space-6) 0 var(--space-8); }
      .logo { width: 104px; height: 104px; border-radius: var(--radius-lg); }
      h1 { font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); line-height: 1.15; margin: var(--space-4) 0 0; letter-spacing: -0.01em; }
      .sub { color: var(--color-ink-muted); font-size: var(--font-size-lg); max-width: 30rem; margin: var(--space-3) auto 0; line-height: 1.5; }
      .hero-cta { margin-top: var(--space-5); display: flex; align-items: center; justify-content: center; gap: var(--space-3); flex-wrap: wrap; }
      .dl { display: inline-flex; align-items: center; gap: var(--space-2); background: var(--color-brand-700); color: #fff; font-weight: var(--font-weight-semibold); font-size: var(--font-size-sm); padding: 10px 18px; border-radius: var(--radius-sm); }
      .dl:hover { background: var(--color-brand-600); text-decoration: none; }
      .cta-note { color: var(--color-ink-muted); font-size: var(--font-size-xs); }

      h2 { font-size: var(--font-size-xl); font-weight: var(--font-weight-semibold); margin: var(--space-8) 0 var(--space-4); letter-spacing: -0.01em; }
      .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
      .feat { background: var(--color-surface-elevated); border: 1px solid var(--color-outline-base); border-radius: var(--radius-md); padding: var(--space-5); }
      .feat h3 { margin: 0 0 var(--space-2); font-size: var(--font-size-md); }
      .feat p { margin: 0; color: var(--color-ink-muted); font-size: var(--font-size-sm); line-height: 1.5; }

      .steps { margin: 0; padding-left: var(--space-5); display: grid; gap: var(--space-3); color: var(--color-ink-muted); line-height: 1.5; }
      .steps strong { color: var(--color-ink-base); }
      .qa { padding: var(--space-4) 0; border-bottom: 1px solid var(--color-outline-base); }
      .qa h3 { margin: 0 0 var(--space-2); font-size: var(--font-size-md); }
      .qa p { margin: 0; color: var(--color-ink-muted); font-size: var(--font-size-sm); line-height: 1.5; }

      .foot { max-width: 720px; margin: 0 auto; padding: var(--space-8) var(--space-6); text-align: center; color: var(--color-ink-muted); font-size: var(--font-size-sm); border-top: 1px solid var(--color-outline-base); }
      .foot p { margin: 0 0 var(--space-2); }
      .muted { color: var(--color-ink-subtle); font-size: var(--font-size-xs); }

      @media (max-width: 560px) { .features { grid-template-columns: 1fr; } }
    </style>

    <script is:inline>
      document.getElementById("theme")?.addEventListener("click", () => {
        const el = document.documentElement;
        const dark = el.dataset.theme
          ? el.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        el.dataset.theme = dark ? "light" : "dark";
        localStorage.setItem("theme", el.dataset.theme);
      });
    </script>
  </body>
</html>
