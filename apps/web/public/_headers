# Security headers for Cloudflare Pages. The CSP enforces the privacy promise:
# scripts, styles, images, and network all stay same-origin — nothing can phone
# home or inject a remote exfiltration script.
#
# Notes:
#   * 'wasm-unsafe-eval' is required to instantiate the WASM conversion core.
#   * 'unsafe-inline' covers Astro's inline theme script + scoped styles. The
#     conversion logic itself is bundled (external module), not inline.
#   * blob:/data: img + blob: worker cover object-URL thumbnails/downloads and
#     the bundled conversion Web Worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
