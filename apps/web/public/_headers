# Security headers for Cloudflare Pages. The CSP enforces the privacy promise:
# scripts, styles, images, and network all stay same-origin — nothing can phone
# home or inject a remote exfiltration script.
#
# Notes:
#   * 'wasm-unsafe-eval' is required to instantiate the WASM conversion core.
#   * script-src pins the two inline theme scripts (before-paint + toggle) by
#     sha256 hash instead of 'unsafe-inline' — recompute the hashes if either
#     script in index.astro changes, or the browser will refuse to run it. The
#     conversion logic itself is a bundled external module, not inline.
#   * style-src still needs 'unsafe-inline' for Astro's scoped styles.
#   * blob:/data: img + blob: worker cover object-URL thumbnails/downloads and
#     the bundled conversion Web Worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-VwYoYK5/mTTwbj+UQeDBGHEfMfpINADaNAjDJpPA5Ac=' 'sha256-DTi7Uvw8ROw6gFGrs8XGTckoXONKbTYtrqEt++MEK3Q=' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
