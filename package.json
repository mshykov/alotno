{
  "name": "alotno",
  "version": "0.1.0",
  "private": true,
  "description": "One Rust engine, every platform: PNG → SVG / PDF / EPS / DXF / WebP.",
  "license": "MIT",
  "author": "Maksym Shykov",
  "repository": "https://github.com/mshykov/alotno",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "tokens": "pnpm --filter @alotno/design build",
    "wasm": "wasm-pack build bindings/wasm --target web --out-dir pkg --release",
    "dev": "pnpm --filter @alotno/web dev",
    "build": "pnpm tokens && pnpm --filter @alotno/web build"
  }
}
